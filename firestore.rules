rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner() { return request.auth != null && request.auth.uid == 'bnPCGBPKIcT0zbMlOcd6Z6ttGr22'; }
  match /apps/{id} { allow read, write: if owner(); }
  match /releaseDrafts/{id} {
   allow read: if owner();
   allow create: if owner() && request.resource.data.status == 'draft';
   allow update: if owner() && resource.data.status == 'draft' && request.resource.data.status == 'draft' && request.resource.data.appId == resource.data.appId;
   allow delete: if owner() && resource.data.status == 'draft';
  }
  match /notificationDrafts/{id} {
   allow read: if owner();
   allow create: if owner() && request.resource.data.status == 'draft';
   allow update: if owner() && resource.data.status == 'draft' && request.resource.data.status == 'draft' && request.resource.data.appId == resource.data.appId;
   allow delete: if owner() && resource.data.status == 'draft';
  }
  match /configDrafts/{id} {
   allow read: if owner();
   allow create, update: if owner()
    && request.resource.data.keys().hasOnly(['appId','platform','revision','config','updatedAt'])
    && request.resource.data.appId is string
    && request.resource.data.platform in ['android','web']
    && id == request.resource.data.appId + '_' + request.resource.data.platform
    && request.resource.data.revision is int
    && request.resource.data.revision > 0
    && request.resource.data.config is map
    && exists(/databases/$(database)/documents/apps/$(request.resource.data.appId));
  }
  match /analyticsDaily/{appId}/days/{day} { allow read: if owner(); }
  match /crashSummaries/{appId}/issues/{issue} { allow read: if owner(); }
  match /auditLogs/{id} { allow read: if owner(); }
  match /adminAlerts/{appId}/items/{id} {
   allow read: if owner();
   allow update: if owner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledged','acknowledgedAt']) && request.resource.data.acknowledged == true && request.resource.data.acknowledgedAt == request.time;
  }
  match /managedDrafts/{appId}/{kind}/{id} {
   allow read: if owner() && appId == '3al-tabloh' && kind in ['content','database'];
   allow create, update: if owner() && appId == '3al-tabloh' && kind in ['content','database'] && request.resource.data.keys().hasOnly(['title','body','revision','status','updatedAt']) && request.resource.data.status == 'draft' && request.resource.data.title is string && request.resource.data.title.size() <= 200 && request.resource.data.body is string && request.resource.data.body.size() <= 30000 && request.resource.data.revision is int && request.resource.data.revision > 0;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
