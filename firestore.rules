rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner() { return request.auth != null && request.auth.uid == 'bnPCGBPKIcT0zbMlOcd6Z6ttGr22'; }
  match /apps/{id} { allow read, write: if owner(); }
  match /releaseDrafts/{id} {
   allow read: if owner();
   allow create: if owner() && request.resource.data.status == 'draft';
   allow update: if owner() && resource.data.status == 'draft' && request.resource.data.status == 'draft' && request.resource.data.appId == resource.data.appId;
   allow delete: if owner() && resource.data.status == 'draft';
  }
  match /notificationDrafts/{id} {
   allow read: if owner();
   allow create: if owner() && request.resource.data.status == 'draft';
   allow update: if owner() && resource.data.status == 'draft' && request.resource.data.status == 'draft' && request.resource.data.appId == resource.data.appId;
   allow delete: if owner() && resource.data.status == 'draft';
  }
  match /configDrafts/{id} {
   allow read: if owner();
   allow create, update: if owner()
    && request.resource.data.keys().hasOnly(['appId','platform','revision','config','updatedAt'])
    && request.resource.data.appId is string
    && request.resource.data.platform in ['android','web']
    && id == request.resource.data.appId + '_' + request.resource.data.platform
    && request.resource.data.revision is int
    && request.resource.data.revision > 0
    && request.resource.data.config is map
    && exists(/databases/$(database)/documents/apps/$(request.resource.data.appId));
  }
  match /analyticsDaily/{appId}/days/{day} { allow read: if owner(); }
  match /crashSummaries/{appId}/issues/{issue} { allow read: if owner(); }
  match /auditLogs/{id} { allow read: if owner(); }
  match /adminAlerts/{appId}/items/{id} {
   allow read: if owner();
   allow update: if owner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledged','acknowledgedAt']) && request.resource.data.acknowledged == true && request.resource.data.acknowledgedAt == request.time;
  }
  match /managedDrafts/{appId}/{kind}/{id} {
   allow read: if owner() && appId == '3al-tabloh' && kind in ['content','database'];
   allow create, update: if owner() && appId == '3al-tabloh' && kind in ['content','database'] && request.resource.data.keys().hasOnly(['title','body','revision','status','updatedAt']) && request.resource.data.status == 'draft' && request.resource.data.title is string && request.resource.data.title.size() <= 200 && request.resource.data.body is string && request.resource.data.body.size() <= 30000 && request.resource.data.revision is int && request.resource.data.revision > 0;
  }
  match /publishedReleases/{id} {
   allow get: if owner() || (id in ['exmore','3al-tabloh'] && resource.data.mandatory == false);
   allow list: if owner();
   allow create, update: if owner()
    && request.resource.data.keys().hasOnly(['appId','version','code','url','notes','mandatory','publishedAt'])
    && request.resource.data.appId == id
    && request.resource.data.code is int && request.resource.data.code > 0
    && request.resource.data.code <= 2100000000
    && request.resource.data.version is string
    && request.resource.data.url is string
    && request.resource.data.url.matches('https://.*')
    && request.resource.data.mandatory == false
    && request.resource.data.publishedAt == request.time
    && (!exists(/databases/$(database)/documents/publishedReleases/$(id)) || request.resource.data.code > resource.data.code);
  }
  // Public configuration contains no private or device data. Publication stays gated.
  match /publicConfigs/{id} {
   allow get: if id in ['exmore_android','altabloh_android','altabloh_web'];
   allow list: if owner();
   allow create, update: if owner() && id in ['exmore_android','altabloh_android','altabloh_web']
    && request.resource.data.keys().hasOnly(['schemaVersion','projectId','platform','revision','expiresAt','maintenance','flags'])
    && request.resource.data.schemaVersion == 1
    && id == request.resource.data.projectId + '_' + request.resource.data.platform
    && request.resource.data.revision is int && request.resource.data.revision > 0
    && request.resource.data.expiresAt is int && request.resource.data.expiresAt > request.time.toMillis() && request.resource.data.expiresAt <= request.time.toMillis() + 86400000
    && request.resource.data.maintenance is bool && request.resource.data.flags is map && request.resource.data.flags.size() <= 50
    && (!exists(/databases/$(database)/documents/publicConfigs/$(id)) || request.resource.data.revision > resource.data.revision);
   allow delete: if false;
  }

  // APPCORE_DEVICE_REGISTRY_V1
  match /deviceRegistry/{appId}/devices/{deviceId} {
    allow read, delete: if owner()
      && appId in ['exmore','altabloh'];

    allow create, update: if owner()
      && appId in ['exmore','altabloh']
      && deviceId.matches(
        '[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}'
      )
      && request.resource.data.keys().hasAll([
        'projectId','platform','versionCode',
        'lastSeen','source'
      ])
      && request.resource.data.keys().hasOnly([
        'projectId','platform','versionCode',
        'lastSeen','source'
      ])
      && request.resource.data.projectId == appId
      && request.resource.data.platform in ['android','web']
      && (appId != 'exmore'
          || request.resource.data.platform == 'android')
      && request.resource.data.versionCode is int
      && request.resource.data.versionCode > 0
      && request.resource.data.versionCode <= 2100000000
      && request.resource.data.source == 'manual-test'
      && (resource == null ||
          (request.resource.data.projectId == resource.data.projectId
           && request.resource.data.platform == resource.data.platform))
      && request.resource.data.lastSeen == request.time;
  }


  // APPCORE_CONTROL_V2
  match /controlAudit/{id} {
    allow read: if owner();

    allow create: if owner()
      && request.resource.data.keys().hasAll([
        'appId','action','createdAt'
      ])
      && request.resource.data.keys().hasOnly([
        'appId','action','createdAt'
      ])
      && request.resource.data.appId in [
        'exmore','3al-tabloh'
      ]
      && request.resource.data.action in [
        'release.publish',
        'config.publish',
        'bulletin.publish',
        'bulletin.revoke'
      ]
      && request.resource.data.createdAt == request.time;

    allow update, delete: if false;
  }

  match /publicBulletins/{appId} {
    allow get: if appId in ['exmore','3al-tabloh'];
    allow list: if owner();

    allow create, update: if owner()
      && appId in ['exmore','3al-tabloh']
      && request.resource.data.keys().hasAll([
        'appId','title','body','active','revision','updatedAt'
      ])
      && request.resource.data.keys().hasOnly([
        'appId','title','body','active','revision','updatedAt'
      ])
      && request.resource.data.appId == appId
      && request.resource.data.title is string
      && request.resource.data.title.size() > 0
      && request.resource.data.title.size() <= 100
      && request.resource.data.body is string
      && request.resource.data.body.size() > 0
      && request.resource.data.body.size() <= 1000
      && request.resource.data.active is bool
      && request.resource.data.revision is int
      && request.resource.data.revision > 0
      && (resource == null ||
          request.resource.data.revision > resource.data.revision)
      && request.resource.data.updatedAt == request.time;

    allow delete: if false;
  }

  match /healthRuns/{id} {
    allow read: if owner();
    allow create: if owner()
      && request.resource.data.keys().hasAll(['createdAt','results','failed'])
      && request.resource.data.keys().hasOnly(['createdAt','results','failed'])
      && request.resource.data.createdAt == request.time
      && request.resource.data.results is list
      && request.resource.data.results.size() == 5
      && request.resource.data.failed is int
      && request.resource.data.failed >= 0
      && request.resource.data.failed <= 5;
    allow update, delete: if false;
  }
  // Capability-based, explicitly paired pilot devices. No public reads.
  match /pairedDevices/{appId}/items/{token} {
    allow read, delete: if owner();
    allow create: if owner() && appId in ['exmore','altabloh']
      && token.matches('[a-f0-9]{64}')
      && request.resource.data.keys().hasOnly(['platform','versionCode','lastSeen'])
      && request.resource.data.platform in ['android','web']
      && (appId != 'exmore' || request.resource.data.platform == 'android')
      && request.resource.data.versionCode == 0
      && request.resource.data.lastSeen == request.time;
    allow update: if appId in ['exmore','altabloh']
      && token.matches('[a-f0-9]{64}')
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['versionCode','lastSeen'])
      && request.resource.data.versionCode is int
      && request.resource.data.versionCode > 0
      && request.resource.data.versionCode <= 2100000000
      && request.resource.data.lastSeen == request.time
      && (resource.data.versionCode == 0 || request.time >= resource.data.lastSeen + duration.value(1,'h'));
  }
  match /publicCatalog/{kind}/items/{id} {
    allow get: if kind in ['content','database'];
    allow list: if owner();
    allow create, update: if owner() && kind in ['content','database']
      && id.matches('[a-z0-9][a-z0-9_-]{0,79}')
      && request.resource.data.keys().hasOnly(['title','body','revision','active','updatedAt'])
      && request.resource.data.title is string && request.resource.data.title.size() <= 200
      && request.resource.data.body is string && request.resource.data.body.size() <= 30000
      && request.resource.data.active is bool
      && request.resource.data.revision is int && request.resource.data.revision > 0
      && (resource == null || request.resource.data.revision > resource.data.revision)
      && request.resource.data.updatedAt == request.time;
    allow delete: if false;
  }
  // Owner-created test notification jobs; only Google IAM backend may update status.
  match /operationsNotifications/{id} {
   allow read: if owner();
   allow create: if owner() && id.matches('[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}')
     && request.resource.data.keys().hasAll(['appId','title','body','audience','status','createdAt'])
     && request.resource.data.keys().hasOnly(['appId','title','body','audience','status','createdAt'])
     && request.resource.data.appId in ['exmore','altabloh']
     && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
     && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 1000
     && request.resource.data.audience == 'test' && request.resource.data.status == 'queued'
     && request.resource.data.createdAt == request.time;
   allow update: if owner() && resource.data.status == 'queued'
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
     && request.resource.data.status == 'cancelled';
   allow delete: if false;
  }
  // Anonymous, self-reported, opt-in installations. Not app attestation.
  match /registeredDevices/{appId}/items/{uid} {
    function installation() { return request.auth != null && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider == 'anonymous' && appId in ['exmore','altabloh']; }
    function validRegistration() {
      return request.resource.data.keys().hasAll(['platform','versionCode','lastSeen'])
        && request.resource.data.keys().hasOnly(['platform','versionCode','lastSeen'])
        && request.resource.data.platform == 'android'
        && request.resource.data.versionCode is int && request.resource.data.versionCode > 0 && request.resource.data.versionCode <= 2100000000
        && request.resource.data.lastSeen == request.time;
    }
    allow read: if owner();
    allow create: if installation() && validRegistration();
    allow update: if installation() && validRegistration() && request.time >= resource.data.lastSeen + duration.value(1,'h');
    allow delete: if owner() || installation();
  }
  // Explicit Web test subscription; tokens are never publicly readable.
  match /webPushSubscriptions/{uid} {
   function selfAnonymous(){return request.auth != null && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider == 'anonymous';}
   function validSubscription(){return request.resource.data.keys().hasAll(['token','updatedAt']) && request.resource.data.keys().hasOnly(['token','updatedAt']) && request.resource.data.token is string && request.resource.data.token.size() >= 20 && request.resource.data.token.size() <= 4096 && request.resource.data.updatedAt == request.time;}
   allow read: if owner();
   allow create: if selfAnonymous() && validSubscription();
   allow update: if selfAnonymous() && validSubscription() && request.time >= resource.data.updatedAt + duration.value(1,'m');
   allow delete: if owner() || selfAnonymous();
  }
  match /webPushJobs/{id} {
   allow read: if owner();
   allow create: if owner() && id.matches('[0-9a-f-]{36}') && request.resource.data.keys().hasAll(['uid','title','body','status','createdAt']) && request.resource.data.keys().hasOnly(['uid','title','body','status','createdAt']) && request.resource.data.uid is string && request.resource.data.uid.matches('[A-Za-z0-9_-]{1,128}') && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100 && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 1000 && request.resource.data.status == 'queued' && request.resource.data.createdAt == request.time;
   allow update: if owner() && resource.data.status == 'queued' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'cancelled';
   allow delete: if false;
  }
  match /diagnosticSnapshots/{id} {
   allow read: if owner() && id in ['exmore','altabloh'];
   allow write: if false; // trusted IAM batch import only
  }
  match /{document=**} { allow read, write: if false; }
 }
}
