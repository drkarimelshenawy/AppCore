rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner() { return request.auth != null && request.auth.uid == 'bnPCGBPKIcT0zbMlOcd6Z6ttGr22'; }
  match /apps/{id} { allow read, write: if owner(); }
  match /releaseDrafts/{id} { allow read, write: if owner(); }
  match /notificationDrafts/{id} { allow read, write: if owner(); }
  match /{document=**} { allow read, write: if false; }
 }
}
